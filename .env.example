HEALTH_AI_PROVIDER=mock            # on-device fallback; set "openai" to enable disclosed cloud/live AI paths
HEALTH_AI_MODEL=
HEALTH_AI_API_KEY=                 # OpenAI key used by /api/realtime/token and /api/food/vision
DEMO_PASSCODE=                     # shared demo invite; send Ladder links as #invite=<value>, never ?k=
FAMILY_AI_SESSION_SECRET=          # required for family AI; generate at least 32 random bytes
HEALTH_AI_REALTIME_MODEL=gpt-realtime-2
HEALTH_AI_VISION_MODEL=gpt-4o-mini # vision model for the typed/fallback camera Q&A
HEALTH_AI_PACKAGE_MODEL=gpt-5.6-luna # detailed package OCR baseline; change only after the release corpus passes
FOOD_PACKAGE_SCAN_ENABLED=0        # server paid-route gate; keep off outside reviewed local evaluation
NEXT_PUBLIC_FOOD_PACKAGE_SCAN=0    # build-time personal-door package controls
FOOD_PACKAGE_SESSION_SECRET=       # required for package scan; generate at least 32 random bytes
USDA_FDC_API_KEY=                  # optional FoodData Central fallback; DEMO_KEY works
