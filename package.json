{
  "name": "home-health-ai-ownership-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "bundle:ladder": "node scripts/check-ladder-bundle.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:offline": "npm run build && playwright test --config=playwright.offline.config.ts",
    "crisis:gate": "node scripts/crisis-gate.mjs",
    "navigator:gate": "node scripts/navigator-gate.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run bundle:ladder"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "barcode-detector": "^3.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^25.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
